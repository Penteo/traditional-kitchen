;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Traditional Kitchen"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://b5hssvx7yrb3k"

[autoload]

EventBus="*res://scripts/controlador/event_bus.gd"
GameController="*res://scripts/controlador/game_controller.gd"
PersistenciaController="*res://scripts/controlador/persistencia_controller.gd"
AudioController="*res://scripts/controlador/audio_controller.gd"
InputController="*res://scripts/controlador/input_controller.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

